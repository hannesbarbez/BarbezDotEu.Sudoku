<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Hannes Barbez</Authors>
    <Company>Hannes Barbez</Company>
    <Title>BarbezDotEu.Sudoku.Generator</Title>
    <Product>BarbezDotEu.Sudoku.Generator</Product>
    <PackageId>BarbezDotEu.Sudoku.Generator</PackageId>
    <Copyright>©2026 Hannes Barbez</Copyright>
    <Version>3.0.0</Version>
    <Description>This package generates Sudoku games.</Description>
    <PackageTags>basic;Sudoku;generator;barbez</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://barbez.eu</PackageProjectUrl>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <RepositoryUrl>https://github.com/hannesbarbez/BarbezDotEu.Sudoku</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageIcon>ICON.png</PackageIcon>
      <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BarbezDotEu.Generic" Version="4.0.0" />
  </ItemGroup>
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\ICON.png" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
